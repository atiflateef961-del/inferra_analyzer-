# Frontend public Firebase configuration
NEXT_PUBLIC_APP_NAME=Inferra AI
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Next.js server-side proxy target for the separately hosted FastAPI service.
# Set this to the deployed backend URL in production; do not use localhost there.
BACKEND_URL=

# Backend configuration
APP_NAME=Inferra AI Backend
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ai_inference
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1000
UPLOAD_DIR=backend/data/uploads
DOCUMENT_INDEX_PATH=backend/data/documents.json
MAX_UPLOAD_BYTES=26214400

# Backend Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
